    {
      "parameters": {
        "jsCode": "const allBusinesses = $input.first().json.allBusinesses || [];\n\nconst withWebsite = allBusinesses.filter(b => {\n  const website = (b.website || b.domain || '').trim();\n  return website !== '';\n});\n\nconst lowRating = allBusinesses.filter(b => {\n  const website = (b.website || b.domain || '').trim();\n  const rating = b.totalScore || b.rating || 0;\n  return website === '' && rating > 0 && rating < 3;\n});\n\nconst valid = allBusinesses.filter(b => {\n  const hasName = (b.businessName || b.title || b.name || '').trim();\n  const hasPhone = (b.phone || b.phoneUnformatted || '').trim();\n  const notClosed = !b.permanentlyClosed;\n  const rating = b.totalScore || b.rating || 0;\n  const hasGoodRating = rating === 0 || rating >= 3;\n  const noWebsite = !(b.website || b.domain || '').trim();\n  return hasName && hasPhone && notClosed && hasGoodRating && noWebsite;\n});\n\nreturn [{\n  json: {\n    totalScraped: allBusinesses.length,\n    validCount: valid.length,\n    filteredCount: withWebsite.length,\n    lowRatingCount: lowRating.length,\n    validLeads: valid,\n    businessType: $('Normalize Webhook Input').first().json.businessType || '',\n    location: $('Normalize Webhook Input').first().json.location || ''\n  }\n}];"
      },
